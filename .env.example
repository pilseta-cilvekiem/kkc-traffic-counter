# Copy to .env (beside detect_bikes.py) and fill in. Read by `detect_bikes.py --report`.

# Project Settings -> API Keys. The *publishable* key: it is safe on the board because
# row-level security, not the key, decides what it may do. Never put the secret key here.
SUPABASE_URL=https://koqvsbumzhrsnstmurol.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Supabase Auth user this device signs in as. Create it under Authentication -> Users,
# then flag it as an uploader (supabase/schema.sql, last statement).
SUPABASE_UPLOADER_EMAIL=
SUPABASE_UPLOADER_PASSWORD=
